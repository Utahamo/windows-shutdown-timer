{
  "name": "windows-shutdown-timer",
  "version": "1.0.0",
  "description": "A modern Windows shutdown timer application built with Electron, Vue 3, and TypeScript",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"pnpm dev:renderer\" \"wait-on http://localhost:5173 && pnpm dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron .",
    "build": "pnpm build:renderer && pnpm build:main && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "electron",
    "vue3",
    "typescript",
    "shutdown-timer",
    "windows"
  ],
  "author": "Utahamo",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.1.7",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "wait-on": "^8.0.1"
  }
}
